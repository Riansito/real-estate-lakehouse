# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - REAL ESTATE LAKEHOUSE
# ==============================================================================

# Modo de Execução: 'cloud' (Neon) ou 'local' (PostgreSQL local)
ENVIRONMENT=cloud

# ------------------------------------------------------------------------------
# 1. DATA WAREHOUSE (POSTGRESQL - NEON CLOUD OU LOCAL)
# ------------------------------------------------------------------------------
# Para Neon Cloud:
# DATABASE_URL=postgresql://neondb_owner:senha@ep-host.aws.neon.tech/neondb?sslmode=require
# Para Docker Local:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/real_estate_dw

DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

POSTGRES_HOST=ep-host.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=your_password
POSTGRES_DB=neondb
POSTGRES_SCHEMA=raw
POSTGRES_SSLMODE=require

# ------------------------------------------------------------------------------
# 2. DATA LAKE (NEON S3-COMPATIBLE STORAGE / AWS S3)
# ------------------------------------------------------------------------------
AWS_ENDPOINT_URL_S3=https://your-storage-id.storage.aws.neon.tech
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-2
S3_BUCKET_NAME=raw-imoveis
